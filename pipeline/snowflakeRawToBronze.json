{
	"name": "snowflakeRawToBronze",
	"properties": {
		"activities": [
			{
				"name": "copyRawToBronze",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"additionalColumns": [
							{
								"name": "SOURCE_FILE_NAME",
								"value": "DIMAIRLINE.csv"
							},
							{
								"name": "INGESTION_TIMESTAMP",
								"value": {
									"value": "@utcNow()",
									"type": "Expression"
								}
							}
						],
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "SnowflakeV2Sink",
						"importSettings": {
							"type": "SnowflakeImportCopyCommand"
						}
					},
					"enableStaging": true,
					"stagingSettings": {
						"linkedServiceName": {
							"referenceName": "ls_blobstorage_snowflakeStaging",
							"type": "LinkedServiceReference"
						},
						"path": "snowflake/staging"
					},
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "AIRLINE_ID",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "AIRLINE_ID",
									"type": "String",
									"physicalType": "VARCHAR"
								}
							},
							{
								"source": {
									"name": "AIRLINE_NAME",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "AIRLINE_NAME",
									"type": "String",
									"physicalType": "VARCHAR"
								}
							},
							{
								"source": {
									"name": "COUNTRY",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "COUNTRY",
									"type": "String",
									"physicalType": "VARCHAR"
								}
							},
							{
								"source": {
									"name": "SOURCE_FILE_NAME",
									"type": "String"
								},
								"sink": {
									"name": "SOURCE_FILE_NAME",
									"type": "String",
									"physicalType": "VARCHAR"
								}
							},
							{
								"source": {
									"name": "INGESTION_TIMESTAMP",
									"type": "String"
								},
								"sink": {
									"name": "INGESTION_TIMESTAMP",
									"type": "DateTime",
									"physicalType": "TIMESTAMP_NTZ"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_ADFtoADLS_raw_csv_dynamic",
						"type": "DatasetReference",
						"parameters": {
							"p_file_name": "DIMAIRLINE.csv"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_snowflake_bronze_sink",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": []
	}
}