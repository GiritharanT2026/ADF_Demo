					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SnowflakeV2Source",
						"query": {
							"value": "SELECT\n    MAX(INGESTION_TIMESTAMP) AS lastProcessedTimestamp\nFROM BRONZE.DIMAIRLINE\nWHERE INGESTION_TIMESTAMP >\n'@{activity('Lookup_Watermark').output.firstRow.lastProcessedTimestamp}'",
