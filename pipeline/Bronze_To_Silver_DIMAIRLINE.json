			{
				"name": "Merge_Staging_To_Silver",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Copy_Bronze_To_Staging",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "ls_snowflake_connection",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "MERGE INTO SILVER.DIMAIRLINE AS target\nUSING STAGING.DIMAIRLINE AS source\nON target.AIRLINE_ID = source.AIRLINE_ID\n\nWHEN MATCHED AND (\n    NOT EQUAL_NULL(target.AIRLINE_NAME, source.AIRLINE_NAME)\n    OR NOT EQUAL_NULL(target.COUNTRY, source.COUNTRY)\n    OR NOT EQUAL_NULL(target.SOURCE_FILE_NAME, source.SOURCE_FILE_NAME)\n) THEN\n    UPDATE SET\n        AIRLINE_NAME        = source.AIRLINE_NAME,\n        COUNTRY             = source.COUNTRY,\n        SOURCE_FILE_NAME    = source.SOURCE_FILE_NAME,\n        INGESTION_TIMESTAMP = source.INGESTION_TIMESTAMP\n\nWHEN NOT MATCHED THEN\n    INSERT (\n        AIRLINE_ID,\n        AIRLINE_NAME,\n        COUNTRY,\n        SOURCE_FILE_NAME,\n        INGESTION_TIMESTAMP\n    )\n    VALUES (\n        source.AIRLINE_ID,\n        source.AIRLINE_NAME,\n        source.COUNTRY,\n        source.SOURCE_FILE_NAME,\n        source.INGESTION_TIMESTAMP\n    );\n",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00",
					"treatDecimalAsString": false
				}
			},
			{
				"name": "truncateStaging",
				"type": "Script",
				"dependsOn": [
